# Copy to .env and fill in TEST-MODE keys only. .env is gitignored.
# A live-mode key must never be put in this project. The pre-commit hook
# blocks anything shaped like one.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Everything below is non-secret and safe to commit as an example.

# DOCKER_SSH_HOST runs the Jaeger container on another machine's docker daemon
# over ssh. Empty means the local docker CLI. Set it to an ssh destination such
# as user@host when this machine has no docker.
DOCKER_SSH_HOST=

# Where spans go. host:port with no scheme, which is what
# otlptracegrpc.WithEndpoint takes. Empty sends traces to the stdout exporter.
# Known trap, observed 2026-09-01. otlptracegrpc.WithEndpoint takes host:port,
# and OTEL_EXPORTER_OTLP_ENDPOINT is also a standard OpenTelemetry variable that
# parts of the SDK read for themselves and expect a full URL for. A bare
# host:port makes something in that path log "parse url: first path segment in
# URL cannot contain colon" once and carry on. The run completes and every
# number in it stays correct, because no metric reads a trace id, so this fails
# quietly. Check that a run's ledger rows carry a non-empty trace_id before
# trusting a trace link. HONEST-LIMITATIONS 36.
OTEL_EXPORTER_OTLP_ENDPOINT=

# Root of the Jaeger query UI, used to print a link to a run's trace. Defaults
# to http://localhost:16686 when unset.
RZP_JAEGER_UI_URL=
