# policy decision matrix, 1792 cells
# 4 sources x 8 actions x 4 signals x 14 triggers
# ceiling=400000 paise write_off_floor=10000 paise notify_window=10s budget=500
# contact cadence comes from the per-source table, not from the config
#   failed_payment   grace=0s     max_touches=3 cooldown=24h0m0s
#   unpaid_order     grace=1h0m0s max_touches=3 cooldown=24h0m0s
#   overdue_invoice  grace=72h0m0s max_touches=4 cooldown=48h0m0s
# the quiet-hours cells are evaluated at 02:00 IST, every other cell at 12:00 IST
# regenerate with: go test ./internal/policy -update
source=failed_payment action=notify_email signal=none trigger=clean -> escalate R7-UNKNOWN-FAIL-CLOSED remaining=3
